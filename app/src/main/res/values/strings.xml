    <string name="app_name">LINE Feed Blocker</string>
    <string name="accessibility_service_label">LINE Feed Blocker 調査サービス</string>
    <string name="accessibility_service_description">LINEのホーム画面と投稿領域を端末内で判定するための個人用サービスです。調査ログは明示的に有効化した場合だけ端末内へ出力します。</string>
    <string name="screen_title">LINE Feed Blocker</string>
    <string name="production_intro">実機調査で確認した安定ID、ホームタブの選択状態、上部ヘッダー下端、下部タブ上端を端末内だけで判定します。ホーム中央領域を全面的に隠し、判定が曖昧な場合は表示しません。</string>
    <string name="service_status_enabled">調査サービス: 有効</string>
    <string name="service_status_disabled">調査サービス: 無効（端末設定から手動で有効にしてください）</string>
